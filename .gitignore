# ── Hidden/dot directories ─────────────────────────────────────────────────
.claude/
memory/
.deps/
.vscode/*
!.vscode/extensions.json
.idea/
cmake-build-*/

# ── Project-specific excluded directories ─────────────────────────────────
/contexts/
/session_summaries/
/imgs/
/readings/
/build/
/build-tsan/
/blender/

# ── Logs: track the folder (via .gitkeep) but ignore all log files ─────────
logs/*
!logs/.gitkeep

# ── C++ build artifacts ────────────────────────────────────────────────────
*.o
*.a
*.so
*.dylib
*.out
compile_commands.json
CMakeCache.txt
CMakeFiles/
_deps/

# ── Frontend ────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
.parcel-cache/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
.env

# ── Config overrides — never commit local config ────────────────────────────
config/dev.json
config/local.json
config/default.json
*.env
.env.*

# ── Secrets ─────────────────────────────────────────────────────────────────
*.pem
*.key
*.p12
id_rsa
id_ed25519

# ── IDE ──────────────────────────────────────────────────────────────────────
*.suo
*.user
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
coverage/
lcov.info
.nyc_output/
*.sqlite
*.sqlite3


CLAUDE.md
